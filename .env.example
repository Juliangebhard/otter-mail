# Copy to .env.local (gitignored) for local builds; CI reads the same names
# from the repository's Actions variables and secrets.

# Google OAuth "Desktop app" client in the primary Google Cloud project.
OTTER_MAIL_GOOGLE_CLIENT_ID=
OTTER_MAIL_GOOGLE_CLIENT_SECRET=

# Keep the previous client available to refresh existing mailbox sign-ins.
OTTER_MAIL_GOOGLE_LEGACY_CLIENT_ID=
OTTER_MAIL_GOOGLE_LEGACY_CLIENT_SECRET=

# For local developer tests only; never shared with app users or given a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Dedicated Google demo account for manual Gmail/Calendar sign-in, not OAuth client credentials.
# Keep these in the main checkout's ignored .env.local; T3 worktrees share it by symlink.
# Agent/browser test inputs only: never expose through VITE_ variables or bundle in the app.
OTTER_MAIL_GMAIL_DEMO_EMAIL=
OTTER_MAIL_GMAIL_DEMO_PASSWORD=
